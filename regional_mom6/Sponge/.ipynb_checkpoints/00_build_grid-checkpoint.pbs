#!/bin/bash
#PBS -N build_grid
#PBS -P nm03
#PBS -q normalbw
#PBS -l ncpus=28
#PBS -l mem=252GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/nm03+gdata/ik11+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -o build_grid.log
#PBS -k oe

set -e
set -o pipefail
set -x
trap 'echo "*** FAILED at line $LINENO (exit code $?) ***" >&2' ERR

module use /g/data/xp65/public/modules
module load conda/analysis3-26.09

echo "Job $PBS_JOBID starting on $(hostname) at $(date)"
echo "Using python: $(which python3)"

python3 -u 00_build_grid.py

echo "Job finished at $(date)"
