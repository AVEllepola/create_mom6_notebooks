#!/bin/bash
#PBS -N concat_statefiles
#PBS -P nm03
#PBS -q normalbw
#PBS -l ncpus=14
#PBS -l mem=128GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/nm03+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -o concat_statefiles.log
#PBS -k oe

set -e
set -o pipefail
set -x
trap 'echo "*** FAILED at line $LINENO (exit code $?) ***" >&2' ERR

module use /g/data/xp65/public/modules
module load conda/analysis3-26.09

echo "Job $PBS_JOBID starting on $(hostname) at $(date)"
echo "Using python: $(which python3)"

python3 -u 03_concatenate_days.py

echo "Job finished at $(date)"
